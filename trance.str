// RPStrudel: Strudel patterns on the OPL2
// Ctrl+Enter plays your changes, Ctrl+. stops
setcpm(30)

$: n("<0 4 0 9 7>*16".add("<7 _ _ 6 5 _ _ 6>*2")).scale("g:minor").trans(-12)
$: n("<7 _ _ 6 5 _ <5 3> <6 4>>*2").scale("g:minor").trans(-24).s("sawtooth")
.gain(0.3)
$: s("hh*8")
$: s("cp:9!4")
$: s("bd:2!4")


