# Key test: arrows whose escape sequence is split across frames (as real
# hardware can deliver them), and a held arrow key, which must not make the
# music late. Run with:
#   ./tools/rp6502-emu build/llvm-mos/release/RPStrudel.rp6502 --mute --script tests/keys.script

run 60
# ESC, then "[B" a frame later: Down, not "[B" typed
key escape
run 1
type "[B"
run 10
key escape
run 1
type "[B"
run 10
key escape
run 1
type "[C"
run 10
press 0xE0
press 0x07
run 2
release 0x07
release 0xE0
run 60
expect "Ln    3  Col   2"
expect-not "[B"

# an arrow held down (key repeat every 2 frames) for about 7 seconds
key down
run 2
key down
run 2
key down
run 2
key down
run 2
key down
run 2
key down
run 2
key down
