# Smoke test: the demo program plays through the pattern engine, keys the
# OPL2 voices, Esc stops them and Ctrl+Enter starts them again. Run with:
#   ./tools/rp6502-emu build/llvm-mos/release/RPStrudel.rp6502 --mute --script tests/smoke.script

run 100
# Voices go out in time order: 1 bd, 2 hh (drums at C4: block 4, F-number
# 345), 3 synth bass, 4 epiano, 5 sd.
peek xram:0xB0 0x31 0x31
peek xram:0xA0 0x59 0x59
# waveform select on
peek xram:0x01 0x20

# Esc stops: every voice keyed off
press escape
run 3
release escape
run 10
peek xram:0xB0 0x11 0x11

# Ctrl+Enter starts again from cycle 0
press 0xE0
press 0x28
run 3
release 0x28
release 0xE0
run 40
peek xram:0xB0 0x31 0x31
